APP_NAME="Qiyas Platform"
APP_ENV=local
APP_KEY=
# Generate with: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qiyas_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@qiyas.local"
MAIL_FROM_NAME="${APP_NAME}"

# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# Active Directory / LDAP Settings
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=dc=company,dc=local
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_USE_SSL=false
LDAP_USE_TLS=false

# Qiyas Platform Settings
QIYAS_MAX_UPLOAD_MB=20
QIYAS_ALLOWED_TYPES=pdf,docx,xlsx,pptx,zip
QIYAS_REMINDER_DAYS=7

VITE_APP_NAME="${APP_NAME}"

# ── Production safety ────────────────────────────────────────────────────
# Demo/test seeders refuse to run when APP_ENV=production. Set this only for
# a deliberately seeded test environment — never on a real deployment.
ALLOW_TEST_SEEDERS_IN_PRODUCTION=false

# Initial Super Admin credential. Leave blank to have one generated and
# printed once by SuperAdminSeeder. Either way a password change is forced
# at first sign-in.
SUPERADMIN_INITIAL_PASSWORD=
SUPERADMIN_EMAIL=

# CORS: the exact origin the SPA is served from in this environment.
FRONTEND_URL=http://localhost:5173
